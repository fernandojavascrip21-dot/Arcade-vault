# Resend (https://resend.com) — used by app/api/contact/route.ts to send the
# "About" page contact form by email. Server-side only, never exposed to the client.
#
# NOTE: while the Resend account has no verified domain, emails are sent from the
# sandbox address `onboarding@resend.dev`, which only delivers to the email address
# the Resend account was created with — regardless of the value set below.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
SUPERBASE_DB_PASSWORD=
