# Resend (https://resend.com) — used by app/api/contact/route.ts to send the
# "About" page contact form by email. Server-side only, never exposed to the client.
#
# NOTE: while the Resend account has no verified domain, emails are sent from the
# sandbox address `onboarding@resend.dev`, which only delivers to the email address
# the Resend account was created with — regardless of the value set below.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente del correo de bienvenida (lib/email/welcome.ts, spec 21). Opcional:
# por defecto `onboarding@resend.dev` (sandbox: solo entrega al correo dueño de la
# cuenta de Resend). Para llegar a usuarios reales verifica un dominio en Resend
# y pon aquí, por ejemplo, `Arcade Vault <hola@tu-dominio.com>`.
RESEND_FROM_EMAIL=
SUPERBASE_DB_PASSWORD=

# Supabase (https://supabase.com) — client connection. These two are public
# keys by design (shipped in the browser bundle via NEXT_PUBLIC_*), unlike
# RESEND_API_KEY above; still documented empty here to match the repo's pattern.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
